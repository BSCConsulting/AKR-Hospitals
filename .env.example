# Supabase project URL (Project Settings → API)
# Leave unset or as placeholders: appointment requests then fall back to WhatsApp/call
# and the live OPD queue stays hidden.
VITE_SUPABASE_URL=your_project_url

# Supabase anon/public key — safe for the browser only with tight RLS.
# Never put the service_role key in the frontend.
VITE_SUPABASE_ANON_KEY=your_anon_key
